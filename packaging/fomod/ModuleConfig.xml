      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="en" />
          <flagDependency flag="mode" value="0" />
          <flagDependency flag="cleanup" value="0" />
        </dependencies>
        <files>
          <folder source="90_Settings\en\0\0" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="en" />
          <flagDependency flag="mode" value="0" />
          <flagDependency flag="cleanup" value="1" />
        </dependencies>
        <files>
          <folder source="90_Settings\en\0\1" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="en" />
          <flagDependency flag="mode" value="1" />
          <flagDependency flag="cleanup" value="0" />
        </dependencies>
        <files>
          <folder source="90_Settings\en\1\0" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="en" />
          <flagDependency flag="mode" value="1" />
          <flagDependency flag="cleanup" value="1" />
        </dependencies>
        <files>
          <folder source="90_Settings\en\1\1" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="en" />
          <flagDependency flag="mode" value="2" />
          <flagDependency flag="cleanup" value="0" />
        </dependencies>
        <files>
          <folder source="90_Settings\en\2\0" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="en" />
          <flagDependency flag="mode" value="2" />
          <flagDependency flag="cleanup" value="1" />
        </dependencies>
        <files>
          <folder source="90_Settings\en\2\1" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="zh" />
          <flagDependency flag="mode" value="0" />
          <flagDependency flag="cleanup" value="0" />
        </dependencies>
        <files>
          <folder source="90_Settings\zh\0\0" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="zh" />
          <flagDependency flag="mode" value="0" />
          <flagDependency flag="cleanup" value="1" />
        </dependencies>
        <files>
          <folder source="90_Settings\zh\0\1" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="zh" />
          <flagDependency flag="mode" value="1" />
          <flagDependency flag="cleanup" value="0" />
        </dependencies>
        <files>
          <folder source="90_Settings\zh\1\0" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="zh" />
          <flagDependency flag="mode" value="1" />
          <flagDependency flag="cleanup" value="1" />
        </dependencies>
        <files>
          <folder source="90_Settings\zh\1\1" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="zh" />
          <flagDependency flag="mode" value="2" />
          <flagDependency flag="cleanup" value="0" />
        </dependencies>
        <files>
          <folder source="90_Settings\zh\2\0" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="zh" />
          <flagDependency flag="mode" value="2" />
          <flagDependency flag="cleanup" value="1" />
        </dependencies>
        <files>
          <folder source="90_Settings\zh\2\1" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="en" />
        </dependencies>
        <files>
          <folder source="91_ServiceLanguage\en" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="language" value="zh" />
        </dependencies>
        <files>
          <folder source="91_ServiceLanguage\zh" destination="" priority="100" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="sunhelm" value="1" />
          <fileDependency file="cooking reseasoned - cc camping - gourmet patch.esp" state="Active" />
        </dependencies>
        <files>
          <folder source="41_SunHelmFoodPacks\0" destination="" priority="20" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="sunhelm" value="1" />
          <fileDependency file="cooking reseasoned - new foods.esp" state="Active" />
        </dependencies>
        <files>
          <folder source="41_SunHelmFoodPacks\1" destination="" priority="20" />
